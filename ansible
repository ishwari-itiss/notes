-  name: Install
   hosts: nodes
   remote_user: admin
   become: true
   tasks:
    -  name: install tree
       ansible.builtin.apt:
         name: tree
    -  name: install nginx
       ansible.builtin.apt:
          name: nginx
          state: present
    - name: start nginx
      ansible.builtin.service:
        name: nginx
        state: started
        enabled: true


